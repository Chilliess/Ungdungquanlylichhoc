        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    auth_users ||--|| profiles : \&quot;1 - 1\&quot;\n    auth_users ||--o{ subjects : \&quot;1 - N\&quot;\n    auth_users ||--o{ schedules : \&quot;1 - N\&quot;\n    auth_users ||--o{ reminders : \&quot;1 - N\&quot;\n    subjects ||--o{ schedules : \&quot;1 - N\&quot;\n    schedules ||--o{ reminders : \&quot;1 - N\&quot;\n\n    auth_users {\n        uuid id PK\n        string email\n    }\n\n    profiles {\n        uuid id PK, FK \&quot;references auth_users.id\&quot;\n        string full_name\n        string student_code\n        string avatar_url\n        timestamp updated_at\n    }\n\n    subjects {\n        uuid id PK\n        uuid user_id FK \&quot;references auth_users.id\&quot;\n        string subject_code\n        string subject_name\n        int credits\n        string color_code\n        timestamp created_at\n    }\n\n    schedules {\n        uuid id PK\n        uuid user_id FK \&quot;references auth_users.id\&quot;\n        uuid subject_id FK \&quot;references subjects.id\&quot;\n        string room\n        string lecturer\n        int day_of_week\n        time start_time\n        time end_time\n        int periods_count\n        date start_date\n        date end_date\n        timestamp created_at\n    }\n\n    reminders {\n        uuid id PK\n        uuid user_id FK \&quot;references auth_users.id\&quot;\n        uuid schedule_id FK \&quot;references schedules.id\&quot;\n        int remind_before_minutes\n        boolean is_enabled\n        timestamp created_at\n    }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="t2lXudYCj7nzFqXAPgQq-149">
